PORT=8080
# auto: vertex si GEMINI_VERTEX=1, gemini si hay GEMINI_API_KEY, si no modo practica.
AGENT_MODE=auto
GEMINI_API_KEY=
# Vertex AI (recomendado): AGENT_MODE=vertex usa las credenciales de la aplicacion (ADC), sin clave.
# AGENT_MODE=vertex
# GOOGLE_CLOUD_PROJECT=tu-proyecto
VERTEX_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
FIXTURES_DIR=fixtures/reto-03
OUT_DIR=out
# Solicitudes nuevas registradas desde la interfaz (por defecto out/solicitudes; fixtures/ nunca se modifica).
SOLICITUDES_DIR=
# Topes de consumo por turno y por sesion.
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=45000
ACTOR=analista-administrativa
