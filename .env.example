PORT=8080
# auto: usa Gemini si hay GEMINI_API_KEY; si no, modo practica (comandos sin LLM).
AGENT_MODE=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
FIXTURES_DIR=fixtures/reto-03
OUT_DIR=out
# Topes de consumo por turno y por sesion.
MAX_ITERACIONES=25
MAX_TOKENS_SESION=300000
LLM_TIMEOUT_MS=45000
ACTOR=analista-administrativa
